@{ ViewData["Title"] = "Visão geral"; }
<section class="hero"><div><p class="eyebrow">CONTROLE DE DESPESAS COMPARTILHADAS</p><h1>Seu dinheiro, organizado em grupo.</h1><p>Cadastre grupos e acompanhe as despesas de cada um.</p><a class="button" asp-controller="Expenses" asp-action="Create">+ Nova despesa</a></div><div class="hero-mark">D$</div></section>
<div class="stats"><article><span>Grupos</span><strong>@ViewBag.GroupCount</strong></article><article><span>Despesas cadastradas</span><strong>@ViewBag.ExpenseCount</strong></article><article><span>Total registrado</span><strong>R$ @(((decimal)ViewBag.Total).ToString("N2"))</strong></article></div>
<div class="section-heading"><div><p class="eyebrow">ATIVIDADE</p><h2>Despesas recentes</h2></div><a asp-controller="Expenses" asp-action="Index">Ver todas →</a></div>
@if (((IEnumerable<Expense>)ViewBag.RecentExpenses).Any()) { <div class="table-wrap"><table><thead><tr><th>Despesa</th><th>Grupo</th><th>Data</th><th>Valor</th></tr></thead><tbody>@foreach (Expense e in (IEnumerable<Expense>)ViewBag.RecentExpenses) { <tr><td>@e.Title</td><td>@e.DimGroup?.Name</td><td>@e.ExpenseDate.ToString("dd/MM/yyyy")</td><td>R$ @e.Amount.ToString("N2")</td></tr> }</tbody></table></div> } else { <div class="empty">Ainda não há despesas. Crie um grupo e cadastre a primeira despesa.</div> }
