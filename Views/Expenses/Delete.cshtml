@model Expense
@{ ViewData["Title"] = "Excluir despesa"; }
<h1>Excluir despesa</h1><div class="warning">Confirma a exclusão de <strong>@Model.Title</strong> no valor de R$ @Model.Amount.ToString("N2")?</div><form asp-action="Delete"><input type="hidden" asp-for="Id" /><button class="button danger" type="submit">Confirmar exclusão</button> <a class="button secondary" asp-action="Index">Cancelar</a></form>
